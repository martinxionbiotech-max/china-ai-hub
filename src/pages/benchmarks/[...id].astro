---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import LastVerified from '../../components/LastVerified.astro';
import EntityFaq from '../../components/EntityFaq.astro';
import { benchmarkFaqs, datasetJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { getModelIdMap, modelHref } from '../../lib/entity-links';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const benchmarks = await getCollection('benchmarks');
  return benchmarks.map((b) => ({ params: { id: b.id }, props: { b } }));
}

interface Props {
  b: CollectionEntry<'benchmarks'>;
}

const { b } = Astro.props;
const d = b.data;
const { Content } = await render(b);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const modelMap = await getModelIdMap();
const faqs = benchmarkFaqs(d);
const jsonLd = datasetJsonLd({
  id: pageUrl,
  name: `${d.benchmark_name}${d.version ? ` v${d.version}` : ''}`,
  description: `${d.benchmark_name}${d.version ? ` v${d.version}` : ''}: evaluation method and Chinese AI model results, with source types and dates.`,
  dateModified: d.last_verified,
});
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Benchmarks', url: new URL('/benchmarks/', Astro.site).href },
  { name: d.benchmark_name, url: pageUrl },
]);
---

<BaseLayout
  title={d.benchmark_name}
  description={`${d.benchmark_name}${d.version ? ` v${d.version}` : ''}: evaluation method and Chinese AI model results, with source types and dates.`}
  type="article"
>
  <article class="max-w-none">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <p class="text-sm text-gray-500 mb-1"><a href="/benchmarks/">Benchmarks</a> / {d.benchmark_name}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.benchmark_name}{d.version ? ` v${d.version}` : ''}</h1>
    {d.description && <p class="text-gray-600 mb-4">{d.description}</p>}

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.benchmark_name} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose prose-slate max-w-none mb-6"><Content /></div>

    {(d.task_type || d.dataset_size || d.evaluation_method || d.scoring || d.contamination_notes) && (
      <div class="mb-6">
        <h2 class="text-xl font-semibold mb-2">Benchmark methodology</h2>
        <div class="table-wrap">
          <table class="data-table">
            <caption class="sr-only">Methodology of {d.benchmark_name}</caption>
            <tbody>
              {d.task_type && (
                <tr>
                  <th scope="row" class="whitespace-nowrap">Task type</th>
                  <td>{d.task_type}</td>
                </tr>
              )}
              {d.dataset_size && (
                <tr>
                  <th scope="row" class="whitespace-nowrap">Dataset size</th>
                  <td>{d.dataset_size}</td>
                </tr>
              )}
              {d.evaluation_method && (
                <tr>
                  <th scope="row" class="whitespace-nowrap">Evaluation method</th>
                  <td>{d.evaluation_method}</td>
                </tr>
              )}
              {d.scoring && (
                <tr>
                  <th scope="row" class="whitespace-nowrap">Scoring</th>
                  <td>{d.scoring}</td>
                </tr>
              )}
              {d.contamination_notes && (
                <tr>
                  <th scope="row" class="whitespace-nowrap">Contamination notes</th>
                  <td>{d.contamination_notes}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <div class="mb-4"><LastVerified date={d.last_verified} /></div>

    <h2 class="text-xl font-semibold mb-2">Results</h2>
    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Results for {d.benchmark_name}</caption>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Model version</th>
          <th scope="col">Score</th>
          <th scope="col">Metric</th>
          <th scope="col">Date</th>
          <th scope="col">Source type</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {d.evaluations.map((e) => (
          <tr>
            <td>{e.model ? (modelMap.has(e.model) ? <a href={modelHref(modelMap, e.model)}>{e.model}</a> : e.model) : e.benchmark}</td>
            <td>{e.model_version ?? '—'}</td>
            <td>{e.score}</td>
            <td>{e.metric ?? '—'}</td>
            <td>{e.date ?? '—'}</td>
            <td>{e.source_type}</td>
            <td>{e.source_url ? <a href={e.source_url} rel="noopener" target="_blank">link</a> : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
</div>

    {d.limitations && (
      <>
        <h2 class="text-xl font-semibold mb-2">Limitations</h2>
        <p class="text-gray-700 mb-6">{d.limitations}</p>
      </>
    )}

    <p class="text-xs text-gray-500 mb-6">
      Vendor-reported scores are labeled as such. Scores from incompatible benchmark versions are never mixed
      without explanation.
    </p>

    <h2 class="text-xl font-semibold mb-2">Sources</h2>
    <div class="flex flex-wrap gap-2">
      {d.sources.map((s) => <SourceBadge source={s} />)}
    </div>

    <EntityFaq faqs={faqs} />
  </article>
</BaseLayout>
