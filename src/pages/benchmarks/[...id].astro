---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import LastVerified from '../../components/LastVerified.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const benchmarks = await getCollection('benchmarks');
  return benchmarks.map((b) => ({ params: { id: b.id }, props: { b } }));
}

interface Props {
  b: CollectionEntry<'benchmarks'>;
}

const { b } = Astro.props;
const d = b.data;
---

<BaseLayout
  title={d.benchmark_name}
  description={`${d.benchmark_name}${d.version ? ` v${d.version}` : ''}: evaluation method and Chinese AI model results, with source types and dates.`}
  type="article"
>
  <article class="max-w-none">
    <p class="text-sm text-gray-500 mb-1"><a href="/benchmarks/">Benchmarks</a> / {d.benchmark_name}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.benchmark_name}{d.version ? ` v${d.version}` : ''}</h1>
    {d.description && <p class="text-gray-600 mb-4">{d.description}</p>}

    <div class="mb-4"><LastVerified date={d.last_verified} /></div>

    <h2 class="text-xl font-semibold mb-2">Results</h2>
    <table class="data-table mb-6">
      <caption class="sr-only">Results for {d.benchmark_name}</caption>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Model version</th>
          <th scope="col">Score</th>
          <th scope="col">Metric</th>
          <th scope="col">Date</th>
          <th scope="col">Source type</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {d.evaluations.map((e) => (
          <tr>
            <td>{e.model ? <a href={`/models/${e.model}/`}>{e.model}</a> : e.benchmark}</td>
            <td>{e.model_version ?? '—'}</td>
            <td>{e.score}</td>
            <td>{e.metric ?? '—'}</td>
            <td>{e.date ?? '—'}</td>
            <td>{e.source_type}</td>
            <td>{e.source_url ? <a href={e.source_url} rel="noopener" target="_blank">link</a> : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {d.limitations && (
      <>
        <h2 class="text-xl font-semibold mb-2">Limitations</h2>
        <p class="text-gray-700 mb-6">{d.limitations}</p>
      </>
    )}

    <p class="text-xs text-gray-500 mb-6">
      Vendor-reported scores are labeled as such. Scores from incompatible benchmark versions are never mixed
      without explanation.
    </p>

    <h2 class="text-xl font-semibold mb-2">Sources</h2>
    <div class="flex flex-wrap gap-2">
      {d.sources.map((s) => <SourceBadge source={s} />)}
    </div>
  </article>
</BaseLayout>
