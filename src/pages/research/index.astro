---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const research = await getCollection('research');
---

<BaseLayout
  title="Original Research"
  description="Original research and analysis on China's AI ecosystem: pricing, agents, open weights, infrastructure and market structure."
>
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Original Research</h1>
  <p class="text-gray-600 mb-6 max-w-2xl">
    Independently researched analysis of China's AI ecosystem. Facts, analysis, interpretation and uncertainty
    are clearly separated; every article includes a China AI Hub View.
  </p>

  {research.length === 0 ? (
    <p class="text-gray-500">No research published yet. Phase 5 adds the first original research articles.</p>
  ) : (
    <ul class="space-y-4">
      {research.map((r) => (
        <li class="border border-gray-200 rounded-lg bg-white p-5 list-none">
          <a href={`/research/${r.id}/`} class="font-semibold text-lg">{r.data.title}</a>
          {r.data.research_question && (
            <p class="text-sm text-gray-600 mt-1">Research question: {r.data.research_question}</p>
          )}
          <p class="text-sm text-gray-500 mt-1">
            {r.data.published_date ?? 'Undated'}{r.data.updated_date ? ` · updated ${r.data.updated_date}` : ''}
          </p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
