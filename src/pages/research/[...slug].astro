---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getModelIdMap, modelHref } from '../../lib/entity-links';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((r) => ({ params: { slug: r.id }, props: { r } }));
}

interface Props {
  r: CollectionEntry<'research'>;
}

const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);

const modelMap = await getModelIdMap();
const agents = await getCollection('agents');
const agentIds = new Set(agents.map((a) => a.id));
const relatedLinks = d.related_entities.map((e) => {
  if (agentIds.has(e)) return { href: `/agents/${e}/`, label: e };
  if (modelMap.has(e)) return { href: modelHref(modelMap, e), label: e };
  return { href: null, label: e };
}).filter((l) => l.href);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
>
  <article class="max-w-none">
    <p class="text-sm text-gray-500 mb-1"><a href="/research/">Research</a> / {d.title}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.title}</h1>
    <p class="text-sm text-gray-500 mb-4">
      {d.published_date ?? 'Undated'}{d.updated_date ? ` · updated ${d.updated_date}` : ''}
    </p>

    {d.research_question && (
      <p class="text-gray-700 border-l-4 border-[#0f4c81] pl-4 mb-6">
        <strong>Research question:</strong> {d.research_question}
      </p>
    )}

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.title} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose prose-slate max-w-none my-8">
      <Content />
    </div>

    <div class="space-y-6 mb-6">
      <EntityLinks
        title="Related entities"
        links={relatedLinks}
      />
    </div>

    {d.sources.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Sources</h2>
        <div class="flex flex-wrap gap-2">
          {d.sources.map((s) => <SourceBadge source={s} />)}
        </div>
      </>
    )}
  </article>
</BaseLayout>
