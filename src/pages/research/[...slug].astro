---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((r) => ({ params: { slug: r.id }, props: { r } }));
}

interface Props {
  r: CollectionEntry<'research'>;
}

const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
>
  <article class="max-w-none">
    <p class="text-sm text-gray-500 mb-1"><a href="/research/">Research</a> / {d.title}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.title}</h1>
    <p class="text-sm text-gray-500 mb-4">
      {d.published_date ?? 'Undated'}{d.updated_date ? ` · updated ${d.updated_date}` : ''}
    </p>

    {d.research_question && (
      <p class="text-gray-700 border-l-4 border-[#0f4c81] pl-4 mb-6">
        <strong>Research question:</strong> {d.research_question}
      </p>
    )}

    <div class="prose prose-slate max-w-none my-8">
      <Content />
    </div>

    <div class="space-y-6 mb-6">
      <EntityLinks
        title="Related entities"
        links={d.related_entities.map((e) => ({ href: `/models/${e}/`, label: e }))}
      />
    </div>

    {d.sources.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Sources</h2>
        <div class="flex flex-wrap gap-2">
          {d.sources.map((s) => <SourceBadge source={s} />)}
        </div>
      </>
    )}
  </article>
</BaseLayout>
