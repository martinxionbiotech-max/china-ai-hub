---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const news = await getCollection('news');
const sorted = news.sort((a, b) => (b.data.published_date ?? '').localeCompare(a.data.published_date ?? ''));
---

<BaseLayout
  title="News"
  description="Ecosystem news for China AI Hub: model releases, price changes, agents and company developments — used to trigger database updates."
>
  <h1 class="text-3xl font-bold text-gray-900 mb-2">News</h1>
  <p class="text-gray-600 mb-6 max-w-2xl">
    Ecosystem tracking: new models, price changes, new agents, company developments. News triggers database
    updates — it is not the site's primary product.
  </p>

  {sorted.length === 0 ? (
    <p class="text-gray-500">No news items yet.</p>
  ) : (
    <ul class="space-y-3">
      {sorted.map((n) => (
        <li class="border border-gray-200 rounded-lg bg-white p-4 list-none">
          <span class="text-xs text-gray-400">{n.data.published_date}</span>
          <span class="badge ml-2">{n.data.type}</span>
          <a href={`/news/${n.id}/`} class="block font-semibold mt-1">{n.data.title}</a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
