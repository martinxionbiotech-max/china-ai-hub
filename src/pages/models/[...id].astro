---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import LastVerified from '../../components/LastVerified.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import EntityFaq from '../../components/EntityFaq.astro';
import { modelFaqs, softwareApplicationJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getModelIdMap, modelHref } from '../../lib/entity-links';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((model) => ({ params: { id: model.id }, props: { model } }));
}

interface Props {
  model: CollectionEntry<'models'>;
}

const { model } = Astro.props;
const d = model.data;
const { Content } = await render(model);

const modelMap = await getModelIdMap();
const [allModels, allBenchmarks, allAgents, allApis, allCompanies] = await Promise.all([
  getCollection('models'),
  getCollection('benchmarks'),
  getCollection('agents'),
  getCollection('apis'),
  getCollection('companies'),
]);

const companyRec = allCompanies.find((c) => c.id === d.provider || c.data.aliases?.includes(d.provider));

/* Entity definition — derived from verified DB fields only. */
const hqShort = (companyRec?.data.headquarters ?? '').split(';')[0].trim().replace(/^China platform:\s*/i, '');
const definition = `${d.model_name} is a ${d.model_family ?? ''} model developed by ${d.provider}, a Chinese AI company${hqShort ? ` headquartered in ${hqShort}` : ''}${d.release_date ? `, released ${d.release_date}` : ''}${d.context_window != null ? ` with a ${d.context_window.toLocaleString()}-token context window` : ''}${d.open_weight === true ? ' and open weights' : d.open_weight === false ? ' and closed weights' : ''}.`;

/* Entity relationships — all derived from collections. */
const benchLinks = allBenchmarks
  .filter((b) => b.data.evaluations.some((e) => e.model === d.model_id))
  .map((b) => ({ href: `/benchmarks/${b.id}/`, label: b.data.benchmark_name }));
const agentLinks2 = allAgents
  .filter((a) => (a.data.underlying_models ?? []).includes(d.model_id))
  .map((a) => ({ href: `/agents/${a.id}/`, label: a.data.agent_name }));
const familyLinks = allModels
  .filter((m) => m.id !== model.id && m.data.model_family === d.model_family)
  .map((m) => ({ href: modelHref(modelMap, m.data.model_id), label: `${m.data.model_name} (${m.data.status})` }));
const apiLinks2 = allApis
  .filter((a) => a.data.provider === d.provider)
  .map((a) => ({ href: `/api/${a.id}/`, label: `${a.data.api_id} API` }));

/* Family timeline — from release dates already in the DB. */
const familyTimeline = allModels
  .filter((m) => m.data.model_family === d.model_family)
  .map((m) => ({ name: m.data.model_name, id: m.id, date: m.data.release_date, status: m.data.status }))
  .sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const providerUrl = new URL(`/companies/${d.provider}/`, Astro.site).href;
const faqs = modelFaqs(d);
const jsonLd = softwareApplicationJsonLd({
  id: pageUrl,
  name: d.model_name,
  description: `${d.model_name} by ${d.provider}: context window, capabilities, pricing, benchmarks and verified sources.`,
  provider: d.provider,
  providerUrl,
  datePublished: d.release_date,
});
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Models', url: new URL('/models/', Astro.site).href },
  { name: d.model_name, url: pageUrl },
]);

const caps = [
  ['Reasoning', d.capabilities.reasoning],
  ['Coding', d.capabilities.coding],
  ['Math', d.capabilities.math],
  ['Chinese', d.capabilities.chinese],
  ['English', d.capabilities.english],
  ['Multilingual', d.capabilities.multilingual],
  ['Vision', d.capabilities.vision],
  ['Audio', d.capabilities.audio],
  ['Video', d.capabilities.video],
  ['Tool calling', d.capabilities.tool_calling],
  ['Function calling', d.capabilities.function_calling],
  ['Structured output', d.capabilities.structured_output],
  ['Agent capability', d.capabilities.agent_capability],
  ['RAG', d.capabilities.rag],
  ['Computer use', d.capabilities.computer_use],
] as const;

const fmt = (v: boolean | null | undefined) => (v === true ? 'Yes' : v === false ? 'No' : 'Unknown');

/* Evidence-type labels for the Data Interpretation table. */
const evidenceLabel: Record<string, string> = {
  vendor_reported: 'Vendor-reported',
  independent: 'Independent',
  academic: 'Academic',
  community: 'Community',
};
---

<BaseLayout
  title={d.model_name}
  description={`${d.model_name} by ${d.provider}: context window, capabilities, pricing, benchmarks and verified sources.`}
  type="article"
>
  <article class="max-w-none">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <p class="text-sm text-gray-500 mb-1">
      <a href="/models/">Models</a> / {d.model_name}
    </p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.model_name}</h1>
    <p class="text-gray-600 mb-4">
      {d.model_family ? `${d.model_family} family · ` : ''}Provider: <a href={`/companies/${d.provider}/`}>{d.provider}</a>
      {' · '}Status: {d.status}
      {d.release_date && <> · Released: {d.release_date}</>}
    </p>

    <p class="text-gray-700 border-l-4 border-[#0f4c81] pl-4 mb-6">{definition}</p>

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.model_name} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mb-4 flex items-center gap-2 text-sm">
      <LastVerified date={d.last_verified} />
    </div>

    <!-- Key facts -->
    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Key facts for {d.model_name}</caption>
      <thead><tr><th scope="col">Key fact</th><th scope="col">Value</th></tr></thead>
      <tbody>
        <tr><th scope="row">Model ID</th><td class="font-mono">{d.model_id}</td></tr>
        {d.version && <tr><th scope="row">Version</th><td>{d.version}</td></tr>}
        <tr><th scope="row">Architecture</th><td>{d.architecture ?? 'Not publicly disclosed'}</td></tr>
        <tr>
          <th scope="row">Context window</th>
          <td>{d.context_window != null ? `${d.context_window.toLocaleString()} tokens` : 'Unknown'}</td>
        </tr>
        {d.maximum_output != null && (
          <tr><th scope="row">Max output</th><td>{d.maximum_output.toLocaleString()} tokens</td></tr>
        )}
        <tr><th scope="row">Open weights</th><td>{fmt(d.open_weight)}</td></tr>
        <tr><th scope="row">License</th><td>{d.license ?? 'Unknown'}</td></tr>
        <tr><th scope="row">Self-hosting</th><td>{fmt(d.self_hosting)}</td></tr>
        <tr><th scope="row">API available</th><td>{fmt(d.api_available)}</td></tr>
        {d.pricing?.input_price_per_1m != null && (
          <tr>
            <th scope="row">API pricing</th>
            <td>
              ${d.pricing.input_price_per_1m} input / ${d.pricing.output_price_per_1m ?? '—'} output per 1M tokens ({d.pricing.currency})
              {d.pricing.effective_date && <> · effective {d.pricing.effective_date}</>}
              {d.pricing.pricing_ref && <> · <a href={`/pricing/${d.pricing.pricing_ref}/`}>provider pricing page</a></>}
            </td>
          </tr>
        )}
        {d.regions.length > 0 && <tr><th scope="row">Regions</th><td>{d.regions.join(', ')}</td></tr>}
        {d.cloud_providers.length > 0 && (
          <tr><th scope="row">Cloud providers</th><td>{d.cloud_providers.join(', ')}</td></tr>
        )}
      </tbody>
    </table>
</div>

    <!-- Capabilities -->
    <h2 class="text-xl font-semibold mb-2">Capabilities</h2>
    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Capabilities of {d.model_name}</caption>
      <thead><tr><th scope="col">Capability</th><th scope="col">Supported</th></tr></thead>
      <tbody>
        {caps.map(([label, v]) => (
          <tr><th scope="row">{label}</th><td>{fmt(v)}</td></tr>
        ))}
      </tbody>
    </table>
</div>

    <!-- Benchmarks -->
    {d.benchmark_results.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Benchmark results</h2>
        <div class="table-wrap mb-6">
<table class="data-table">
          <caption class="sr-only">Benchmark results for {d.model_name}</caption>
          <thead>
            <tr><th scope="col">Benchmark</th><th scope="col">Version</th><th scope="col">Score</th><th scope="col">Metric</th><th scope="col">Date</th><th scope="col">Source type</th><th scope="col">Source</th></tr>
          </thead>
          <tbody>
            {d.benchmark_results.map((b) => (
              <tr>
                <td>{b.benchmark}</td>
                <td>{b.benchmark_version ?? '—'}</td>
                <td>{b.score}</td>
                <td>{b.metric ?? '—'}</td>
                <td>{b.date ?? '—'}</td>
                <td>{b.source_type}</td>
                <td>{b.source_url ? <a href={b.source_url} rel="noopener" target="_blank">link</a> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
</div>
        <p class="text-xs text-gray-500 mb-6">
          Benchmark scores are single data points, not universal rankings. Vendor-reported scores are labeled as such.
        </p>
      </>
    )}

    <!-- Known limitations -->
    {d.known_limitations.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Known limitations</h2>
        <ul class="list-disc pl-5 mb-6 text-gray-700">
          {d.known_limitations.map((l) => <li>{l}</li>)}
        </ul>
      </>
    )}

    <!-- Editorial body -->
    {d.model_name && (
      <div class="prose prose-slate max-w-none mb-8">
        <Content />
      </div>
    )}

    <!-- Related entities -->
    <div class="space-y-6 mb-6">
      <EntityLinks title="Provider" links={[{ href: `/companies/${d.provider}/`, label: d.provider }]} />
      {d.pricing?.pricing_ref && (
        <EntityLinks title="Pricing" links={[{ href: `/pricing/${d.pricing.pricing_ref}/`, label: `${d.pricing.pricing_ref} pricing` }]} />
      )}
      {benchLinks.length > 0 && <EntityLinks title="Benchmarks with results for this model" links={benchLinks} />}
      {agentLinks2.length > 0 && <EntityLinks title="Agents built on this model" links={agentLinks2} />}
      {familyLinks.length > 0 && <EntityLinks title="Related models (same family)" links={familyLinks} />}
      {apiLinks2.length > 0 && <EntityLinks title="API" links={apiLinks2} />}
    </div>

    <!-- Family timeline -->
    {familyTimeline.length > 1 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Model family timeline</h2>
        <div class="table-wrap mb-6">
<table class="data-table">
          <caption class="sr-only">Release timeline for the {d.model_family} family</caption>
          <thead><tr><th scope="col">Model</th><th scope="col">Released</th><th scope="col">Status</th></tr></thead>
          <tbody>
            {familyTimeline.map((m) => (
              <tr class={m.id === model.id ? 'bg-blue-50' : ''}>
                <td>{m.id === model.id ? <strong>{m.name} (this page)</strong> : <a href={modelHref(modelMap, m.id === model.id ? d.model_id : m.id)}>{m.name}</a>}</td>
                <td>{m.date ?? '—'}</td>
                <td>{m.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
</div>
      </>
    )}

    <!-- Data interpretation -->
    <h2 class="text-xl font-semibold mb-2">Data interpretation</h2>
    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Evidence types for {d.model_name}</caption>
      <thead><tr><th scope="col">Field</th><th scope="col">Value</th><th scope="col">Evidence type</th></tr></thead>
      <tbody>
        {d.context_window != null && <tr><th scope="row">Context window</th><td>{d.context_window.toLocaleString()} tokens</td><td>Official</td></tr>}
        {d.architecture && <tr><th scope="row">Architecture</th><td>{d.architecture}</td><td>Official</td></tr>}
        {d.open_weight != null && <tr><th scope="row">Open weights</th><td>{fmt(d.open_weight)}</td><td>Official</td></tr>}
        {d.license && <tr><th scope="row">License</th><td>{d.license}</td><td>Official</td></tr>}
        {d.pricing?.input_price_per_1m != null && (
          <tr>
            <th scope="row">API pricing</th>
            <td>${d.pricing.input_price_per_1m} / ${d.pricing.output_price_per_1m ?? '—'} per 1M tokens ({d.pricing.currency})</td>
            <td>Official</td>
          </tr>
        )}
        {d.benchmark_results.map((b) => (
          <tr>
            <th scope="row">{b.benchmark}{b.benchmark_version ? ` (${b.benchmark_version})` : ''}</th>
            <td>{b.score}{b.metric ? ` ${b.metric}` : ''}</td>
            <td>{evidenceLabel[b.source_type] ?? b.source_type}</td>
          </tr>
        ))}
        <tr><th scope="row">Family position</th><td>{familyTimeline.length} model{familyTimeline.length === 1 ? '' : 's'} in the {d.model_family} family</td><td>China AI Hub analysis</td></tr>
      </tbody>
    </table>
</div>
    <p class="text-xs text-gray-500 mb-6">
      Evidence types: Official = vendor documentation, pricing pages or model cards. Vendor-reported = benchmark
      scores published by the vendor. China AI Hub analysis = derived from the database itself. See the <a href="/about/">sourcing policy</a>.
    </p>

    <!-- Sources -->
    <h2 class="text-xl font-semibold mb-2">Sources</h2>
    <div class="flex flex-wrap gap-2 mb-2">
      {d.sources.map((s) => <SourceBadge source={s} />)}
    </div>
    <p class="text-xs text-gray-500">
      Confidence and source hierarchy per the <a href="/about/">sourcing policy</a>. Facts change; check the source before relying on this page.
    </p>

    <EntityFaq faqs={faqs} />
  </article>
</BaseLayout>
