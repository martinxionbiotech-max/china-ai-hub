<BaseLayout
  title="Editorial Standards"
  description="The quality gate every China AI Hub page must pass: no fabrication, no winner verdicts, four claim labels, answer blocks and internal-link discipline."
  type="article"
  extraJsonLd={[article]}
  canonicalPath="/editorial-standards/"
