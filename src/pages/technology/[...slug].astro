---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import LastVerified from '../../components/LastVerified.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getModelIdMap, modelHref } from '../../lib/entity-links';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const technologies = await getCollection('technologies');
  return technologies.map((t) => ({ params: { slug: t.id }, props: { t } }));
}

interface Props {
  t: CollectionEntry<'technologies'>;
}

const { t } = Astro.props;
const d = t.data;
const { Content } = await render(t);

const guides = await getCollection('guides');
const guideNames = new Map(guides.map((g) => [g.id, g.data.title]));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const modelMap = await getModelIdMap();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': pageUrl,
  headline: d.title,
  url: pageUrl,
  description: d.definition,
  dateModified: d.last_verified,
  isPartOf: { '@type': 'WebSite', name: 'China AI Hub', url: 'https://chinaaihub.com' },
};
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Technology', url: new URL('/technology/', Astro.site).href },
  { name: d.title, url: pageUrl },
]);
---

<BaseLayout
  title={d.title}
  description={d.definition}
  type="article"
>
  <article class="max-w-none">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <p class="text-sm text-gray-500 mb-1"><a href="/technology/">Technology</a> / {d.title}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.title}</h1>
    <p class="text-gray-700 text-lg mb-4">{d.definition}</p>

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.title} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mb-4"><LastVerified date={d.last_verified} /></div>

    <div class="prose prose-slate max-w-none mb-8">
      <Content />
    </div>

    <div class="space-y-6 mb-6">
      <EntityLinks
        title="Related models"
        links={d.related_models.map((m) => ({ href: modelHref(modelMap, m), label: m }))}
      />
      <EntityLinks
        title="Related companies"
        links={d.related_companies.map((c) => ({ href: `/companies/${c}/`, label: c }))}
      />
      <EntityLinks
        title="Related technologies"
        links={d.related_technologies.map((x) => ({ href: `/technology/${x}/`, label: x }))}
      />
      {d.related_guides.length > 0 && (
        <EntityLinks
          title="Related guides"
          links={d.related_guides.map((g) => ({ href: `/guides/${g}/`, label: guideNames.get(g) ?? g }))}
        />
      )}
    </div>

    <h2 class="text-xl font-semibold mb-2">Sources</h2>
    <div class="flex flex-wrap gap-2">
      {d.sources.map((s) => <SourceBadge source={s} />)}
    </div>
  </article>
</BaseLayout>
