---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const pillarIds = [...new Set(guides.filter((g) => g.data.pillar).map((g) => g.data.pillar!))];
const groups = pillarIds.map((id) => {
  const items = guides.filter((g) => g.data.pillar === id);
  const pillar = items.find((g) => g.data.order === 0) ?? items[0];
  const cluster = items
    .filter((g) => g.id !== pillar.id)
    .sort((a, b) => a.data.order - b.data.order);
  return { pillar, cluster };
});
const others = guides
  .filter((g) => !g.data.pillar)
  .sort((a, b) => (b.data.updated_date ?? '').localeCompare(a.data.updated_date ?? ''));
---

<BaseLayout
  title="Chinese AI Guides: Selection, Cost and Deployment"
  description="Practical guides to choosing and running Chinese AI: model selection, API platforms, pricing structure, self-hosting, licensing and enterprise deployment."
>
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Guides</h1>
  <p class="text-gray-600 mb-8 max-w-2xl">
    Practical, sourced guidance for evaluating and using Chinese AI models, APIs and agents.
    Pillars are multi-chapter arguments; the guides below them are self-contained.
  </p>

  {groups.map(({ pillar, cluster }) => (
    <section class="mb-10">
      <a href={`/guides/${pillar.id}/`} class="block border border-gray-300 rounded-lg bg-white p-5 hover:border-gray-400">
        <span class="text-xs uppercase tracking-wide text-[#0f4c81] font-semibold">Pillar</span>
        <h2 class="text-xl font-semibold mt-1">{pillar.data.title}</h2>
        <p class="text-sm text-gray-600 mt-1">{pillar.data.description}</p>
        <span class="text-xs text-gray-500 mt-2 inline-block">Start here · {cluster.length} chapters</span>
      </a>
      {cluster.length > 0 && (
        <ol class="mt-3 space-y-2 ml-1">
          {cluster.map((g) => (
            <li class="text-sm">
              <a href={`/guides/${g.id}/`} class="font-medium">{g.data.title}</a>
              <span class="text-gray-500"> — chapter {g.data.order}</span>
            </li>
          ))}
        </ol>
      )}
    </section>
  ))}

  {others.length > 0 && (
    <>
      <h2 class="text-xl font-semibold mb-3">All guides</h2>
      <ul class="space-y-3">
        {others.map((g) => (
          <li class="border border-gray-200 rounded-lg bg-white p-4 list-none">
            <a href={`/guides/${g.id}/`} class="font-semibold">{g.data.title}</a>
            <p class="text-sm text-gray-600 mt-1">{g.data.description}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
