---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}

interface Props {
  g: CollectionEntry<'guides'>;
}

const { g } = Astro.props;
const d = g.data;
const { Content } = await g.render();
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
>
  <article class="max-w-none">
    <p class="text-sm text-gray-500 mb-1"><a href="/guides/">Guides</a> / {d.title}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.title}</h1>
    {d.updated_date && <p class="text-sm text-gray-500 mb-4">Updated: {d.updated_date}</p>}

    <div class="prose prose-slate max-w-none my-8">
      <Content />
    </div>

    {d.sources.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Sources</h2>
        <div class="flex flex-wrap gap-2">
          {d.sources.map((s) => <SourceBadge source={s} />)}
        </div>
      </>
    )}
  </article>
</BaseLayout>
