---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}

interface Props {
  g: CollectionEntry<'guides'>;
}

const { g } = Astro.props;
const d = g.data;
const { Content } = await render(g);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': pageUrl,
  headline: d.title,
  url: pageUrl,
  description: d.description,
  datePublished: d.published_date,
  dateModified: d.updated_date ?? d.published_date,
  isPartOf: { '@type': 'WebSite', name: 'China AI Hub', url: 'https://chinaaihub.com' },
};
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Guides', url: new URL('/guides/', Astro.site).href },
  { name: d.title, url: pageUrl },
]);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
>
  <article class="max-w-none">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <p class="text-sm text-gray-500 mb-1"><a href="/guides/">Guides</a> / {d.title}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.title}</h1>
    {d.updated_date && <p class="text-sm text-gray-500 mb-4">Updated: {d.updated_date}</p>}

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.title} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose prose-slate max-w-none my-8">
      <Content />
    </div>

    {d.sources.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Sources</h2>
        <div class="flex flex-wrap gap-2">
          {d.sources.map((s) => <SourceBadge source={s} />)}
        </div>
      </>
    )}
  </article>
</BaseLayout>
