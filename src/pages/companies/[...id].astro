---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import LastVerified from '../../components/LastVerified.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import EntityFaq from '../../components/EntityFaq.astro';
import { companyFaqs, organizationJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { getModelIdMap, modelHref } from '../../lib/entity-links';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((company) => ({ params: { id: company.id }, props: { company } }));
}

interface Props {
  company: CollectionEntry<'companies'>;
}

const { company } = Astro.props;
const d = company.data;
const { Content } = await render(company);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const modelMap = await getModelIdMap();
const metaDescription = d.description ?? `${d.company_name}: Chinese AI company profile — models, agents, API, open-source projects and official sources.`;

/* Entity definition — derived from verified DB fields only. */
const hqShort2 = (d.headquarters ?? '').split(';')[0].trim().replace(/^China platform:\s*/i, '');
const definition = `${d.company_name} is a Chinese AI company${hqShort2 ? ` headquartered in ${hqShort2}` : ''}${d.founded ? `, founded ${d.founded}` : ''}${d.foundation_models.length > 0 ? `, known for the ${d.foundation_models.slice(0, 3).join(', ')} model${d.foundation_models.length > 1 ? 's' : ''}` : ''}.`;
const faqs = companyFaqs(d);
const jsonLd = organizationJsonLd({
  id: pageUrl,
  name: d.company_name,
  description: metaDescription,
  sameAs: d.official_website ? [d.official_website] : undefined,
  alternateName: d.aliases.length ? d.aliases : undefined,
});
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Companies', url: new URL('/companies/', Astro.site).href },
  { name: d.company_name, url: pageUrl },
]);

const modelLinks = d.foundation_models.map((m) => ({ href: modelHref(modelMap, m), label: m }));
const agentLinks = d.agents.map((a) => ({ href: `/agents/${a}/`, label: a }));
const apiLinks = d.api.map((a) => ({ href: `/api/${a}/`, label: `${a} API` }));
---

<BaseLayout
  title={d.company_name}
  description={metaDescription}
  type="article"
>
  <article class="max-w-none">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <p class="text-sm text-gray-500 mb-1"><a href="/companies/">Companies</a> / {d.company_name}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">{d.company_name}</h1>
    {d.aliases.length > 0 && <p class="text-sm text-gray-500 mb-4">Also known as: {d.aliases.join(', ')}</p>}

    <p class="text-gray-700 border-l-4 border-[#0f4c81] pl-4 mb-6">{definition}</p>

    {d.image && (
      <figure class="mb-6">
        <img src={d.image} alt={d.company_name} class="w-full rounded-lg" loading="lazy" />
        {d.image_credit && (
          <figcaption class="text-xs text-gray-500 mt-1">
            Image: {d.image_credit}{d.image_source && <> · <a href={d.image_source} rel="noopener" target="_blank">source</a></>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mb-4"><LastVerified date={d.last_verified} /></div>

    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Key facts for {d.company_name}</caption>
      <thead><tr><th scope="col">Key fact</th><th scope="col">Value</th></tr></thead>
      <tbody>
        <tr><th scope="row">Founded</th><td>{d.founded ?? 'Unknown'}</td></tr>
        <tr><th scope="row">Headquarters</th><td>{d.headquarters ?? 'Unknown'}</td></tr>
        {d.ownership_information && <tr><th scope="row">Ownership</th><td>{d.ownership_information}</td></tr>}
        {d.official_website && (
          <tr><th scope="row">Official website</th><td><a href={d.official_website} rel="noopener" target="_blank">{d.official_website}</a></td></tr>
        )}
        {d.official_documentation && (
          <tr><th scope="row">Documentation</th><td><a href={d.official_documentation} rel="noopener" target="_blank">{d.official_documentation}</a></td></tr>
        )}
        {d.ai_products.length > 0 && <tr><th scope="row">AI products</th><td>{d.ai_products.join(', ')}</td></tr>}
        {d.cloud_distribution.length > 0 && (
          <tr><th scope="row">Cloud distribution</th><td>{d.cloud_distribution.join(', ')}</td></tr>
        )}
      </tbody>
    </table>
</div>

    {d.major_releases.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Major releases</h2>
        <div class="table-wrap mb-6">
<table class="data-table">
          <caption class="sr-only">Major releases by {d.company_name}</caption>
          <thead><tr><th scope="col">Release</th><th scope="col">Date</th><th scope="col">Type</th></tr></thead>
          <tbody>
            {d.major_releases.map((r) => (
              <tr><td>{r.name}</td><td>{r.date ?? '—'}</td><td>{r.type ?? '—'}</td></tr>
            ))}
          </tbody>
        </table>
</div>
      </>
    )}

    {d.open_source_projects.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2">Open-source projects</h2>
        <ul class="list-disc pl-5 mb-6 text-gray-700">
          {d.open_source_projects.map((p) => <li>{p}</li>)}
        </ul>
      </>
    )}

    <div class="prose prose-slate max-w-none mb-8">
      <Content />
    </div>

    <div class="space-y-6 mb-6">
      <EntityLinks title="Models" links={modelLinks} />
      <EntityLinks title="Agents" links={agentLinks} />
      <EntityLinks title="APIs" links={apiLinks} />
      {d.related_entities.length > 0 && (
        <EntityLinks title="Related entities" links={d.related_entities.map((r) => ({ href: `/companies/${r}/`, label: r }))} />
      )}
    </div>

    <h2 class="text-xl font-semibold mb-2">Sources</h2>
    <div class="flex flex-wrap gap-2">
      {d.sources.map((s) => <SourceBadge source={s} />)}
    </div>

    <!-- Data interpretation -->
    <h2 class="text-xl font-semibold mt-6 mb-2">Data interpretation</h2>
    <div class="table-wrap mb-6">
<table class="data-table">
      <caption class="sr-only">Evidence types for {d.company_name}</caption>
      <thead><tr><th scope="col">Field</th><th scope="col">Value</th><th scope="col">Evidence type</th></tr></thead>
      <tbody>
        {d.founded != null && <tr><th scope="row">Founded</th><td>{d.founded}</td><td>Official</td></tr>}
        {d.headquarters && <tr><th scope="row">Headquarters</th><td>{d.headquarters.split(';')[0]}</td><td>Official</td></tr>}
        {d.ownership_information && <tr><th scope="row">Ownership</th><td>{d.ownership_information}</td><td>Official</td></tr>}
        {d.foundation_models.length > 0 && <tr><th scope="row">Foundation models</th><td>{d.foundation_models.join(', ')}</td><td>Official</td></tr>}
        {d.major_releases.length > 0 && <tr><th scope="row">Major releases</th><td>{d.major_releases.length} entries</td><td>Official</td></tr>}
        <tr><th scope="row">Entity relations</th><td>{modelLinks.length} models, {agentLinks.length} agents, {apiLinks.length} APIs</td><td>China AI Hub analysis</td></tr>
      </tbody>
    </table>
</div>
    <p class="text-xs text-gray-500 mb-6">
      Evidence types: Official = vendor documentation or official pages. China AI Hub analysis = derived from the database itself. See the <a href="/about/">sourcing policy</a>.
    </p>

    <EntityFaq faqs={faqs} />
  </article>
</BaseLayout>
