---
interface Props {
  date: string;
  /** Days before a page is due for re-verification. Model and pricing data move faster than company profiles. */
  cadence?: number;
}

const { date, cadence = 90 } = Astro.props;
const verified = new Date(date + 'T00:00:00Z');
const review = new Date(verified.getTime() + cadence * 86400000).toISOString().slice(0, 10);
const days = Math.floor((Date.now() - verified.getTime()) / 86400000);
const overdue = days > cadence;
---

<span class={overdue ? 'text-amber-700' : 'text-gray-600'}>
  Last verified: <time datetime={date}>{date}</time>
  {' · '}Review cadence: {cadence} days
  {' · '}Next review: <time datetime={review}>{review}</time>
  {overdue && <span> (review due)</span>}
</span>
