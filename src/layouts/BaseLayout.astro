---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  extraJsonLd?: Record<string, unknown>[];
}

const { title, description, type = 'website', extraJsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | China AI Hub</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="China AI Hub" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} | China AI Hub`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="China AI Hub — sourced and verified data on Chinese AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | China AI Hub`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'China AI Hub',
      url: 'https://sinoaihub.com',
      description: 'Independent English-language database and analysis of China AI models, agents, APIs, pricing, benchmarks and technology.',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'China AI Hub',
      url: 'https://sinoaihub.com',
    })} />
    {extraJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-semibold text-lg text-gray-900 hover:no-underline">
          <img src="/logo.svg" alt="China AI Hub" width="30" height="30" class="w-[30px] h-[30px]" loading="eager" />
          China AI Hub
        </a>
        <nav class="hidden md:flex gap-5 text-sm text-gray-700" aria-label="Main navigation">
          <a href="/models/">Models</a>
          <a href="/agents/">Agents</a>
          <a href="/companies/">Companies</a>
          <a href="/api/">API</a>
          <a href="/pricing/">Pricing</a>
          <a href="/benchmarks/">Benchmarks</a>
          <a href="/technology/">Technology</a>
          <a href="/comparisons/">Comparisons</a>
          <a href="/research/">Research</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-gray-200 bg-white mt-12">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-gray-600">
        <p class="mb-2">
          China AI Hub — an independent English-language knowledge platform for China's AI ecosystem.
          All factual claims are sourced and date-stamped. Analysis is clearly labeled.
        </p>
        <p class="mb-2">
          <a href="/about/">About</a> · <a href="/guides/">Guides</a> · <a href="/news/">News</a> · <a href="/research/">Research</a> · <a href="https://data.sinoaihub.com">📚 Data Hub</a>
        </p>
        <p class="mb-2">
          Contact: Martin.W · <a href="mailto:admin@sinoaihub.com">admin@sinoaihub.com</a>
        </p>
        <p class="mb-3">
          <a
            href="https://wa.me/8613323237275"
            rel="noopener"
            target="_blank"
            class="whatsapp-btn"
            aria-label="Chat on WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Chat On Whatsapp
          </a>
        </p>
        <p class="text-gray-400">© {new Date().getFullYear()} China AI Hub</p>
      </div>
    </footer>
  </body>
</html>
